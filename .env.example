# === REQUIRED ===
# Your OpenRouter API key for AI analysis
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Your Solana wallet private key (base58 encoded)
# SECURITY: Never commit your actual .env file!
# Not required when DRY_RUN=true (a random simulated wallet is used instead).
SOLANA_PRIVATE_KEY=your-base58-private-key

# === TESTING / PAPER TRADING ===
# Set to true to test the bot with a simulated wallet and fake SOL balance.
# No real Solana transactions are sent and no real private key is required.
# ALWAYS test with DRY_RUN=true before running with real funds.
DRY_RUN=false

# Fake starting SOL balance used to simulate trades when DRY_RUN=true
PAPER_STARTING_BALANCE_SOL=10

# === TRADING PARAMETERS ===
# Minimum AI confidence score to execute a trade (0-100, default: 80)
MIN_CONFIDENCE=80

# Maximum position size in SOL per trade
MAX_POSITION_SOL=0.5

# Stop loss percentage (e.g., 33 = -33%). Widened from an earlier -15%
# default: memecoins often dip before reversing, so a tight stop can exit a
# trade that would have recovered.
STOP_LOSS_PERCENT=33

# Take profit percentage (e.g., 50 = +50%)
TAKE_PROFIT_PERCENT=50

# Scan interval in seconds
SCAN_INTERVAL_SECONDS=60

# === OPTIONAL ===
# Solana RPC endpoint (defaults to mainnet-beta)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# DexScreener API (no key needed, but you can set a custom base URL)
DEXSCREENER_API_URL=https://api.dexscreener.com

# Jupiter swap API. Works with NO key set (free tier, unchanged default).
# If you have a Jupiter API key (from https://dev.jup.ag — the portal may
# label the value "JUPITER_API"), set it here for higher rate limits /
# reliability. Both JUPITER_API_KEY and JUPITER_API are accepted.
# JUPITER_API_KEY=your-jupiter-api-key
# Only needed if your Jupiter plan requires a different authenticated host
# than the default free endpoint (check your Jupiter portal for the exact
# base URL). Default when unset: https://quote-api.jup.ag/v6
# JUPITER_API_BASE_URL=https://api.jup.ag/swap/v1

# Chains to scan (comma-separated: solana,base,ethereum)
SCAN_CHAINS=solana

# Log level: debug, info, warn, error
LOG_LEVEL=info

# HTTP timeout and retries for external APIs
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=3

# Transaction preflight: keep false for safer execution
ALLOW_SKIP_PREFLIGHT=false

# Local bot state persistence file path
BOT_STATE_FILE=./data/state.json

# Live public web dashboard — MemeScope Command Center (replaces the old manus.space site)
DASHBOARD_WEB_URL=https://memescope-command-center.lovable.app

# Web dashboard API URL + key (for the future plugin connection; no public API yet)
# DASHBOARD_API_URL=https://memescope-command-center.lovable.app/api
# DASHBOARD_API_KEY=your-api-key

# === LIVE DASHBOARD (this repo's built-in web control center) ===
# Port the dashboard API server listens on
DASHBOARD_PORT=4000

# Password hash for dashboard login. Generate with:
#   npm run hash-password -- "your-strong-password"
DASHBOARD_PASSWORD_HASH=

# Secret used to sign dashboard session tokens (use a long random string)
DASHBOARD_JWT_SECRET=

# How long a dashboard session stays valid, in seconds (default 1 hour)
DASHBOARD_SESSION_TTL_SECONDS=3600

# Secondary confirmation code required to approve any SOL withdrawal
# from the Vault Portal (treat like a second password / 2FA code)
WITHDRAWAL_CONFIRMATION_CODE=

# Locks withdrawals to a single Solana address. When set, the Vault Portal can
# only send funds here, so dashboard access plus the confirmation code is not
# enough to redirect funds elsewhere — changing the destination means editing
# this file and restarting the server. Point it at a wallet the bot holds no
# key for. Leave empty to allow withdrawal to any valid address.
WITHDRAWAL_ADDRESS=

# Shared secret the trading bot uses to push executed trades to
# POST /api/trades/ingest (sent as the `x-api-key` header). Set the SAME value
# as DASHBOARD_API_KEY in the bot's .env. Leave empty to disable ingestion.
DASHBOARD_INGEST_KEY=

# Comma-separated list of allowed CORS origins for the dashboard API
# (leave unset to allow the same-origin bundled frontend only)
# DASHBOARD_CORS_ORIGIN=http://localhost:5173

# Local file paths for dashboard-managed state (safe to leave as default)
# BOT_SETTINGS_FILE=./data/settings.json
# WALLET_VAULT_FILE=./data/wallet.vault.json

